# Copy this file to .env and edit as needed
# (The .env file is private — never share it or commit it to git)

# Port for the website (default: 3000)
PORT=3000

# ── Optional pre-configuration ───────────────────────────────────────────────
# Groups can be added interactively via the web UI — no need to set these.
# If you do set them here, they will be imported on the very first run only.
#
# Multiple groups (recommended):
#   WHATSAPP_GROUPS=120363AAA@g.us:Group Name 1,120363BBB@g.us:Group Name 2
#
# Single group (legacy):
#   WHATSAPP_GROUP_ID=120363AAA@g.us
#   WHATSAPP_GROUP_NAME=Group Name
