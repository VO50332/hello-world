# Copy this file to .env and fill in your values
# (The .env file is private — never share it or commit it to git)

# The EXACT name of your WhatsApp group (copy-paste from WhatsApp)
WHATSAPP_GROUP_NAME=שוק מתנות

# Multiple groups (recommended format):
#   WHATSAPP_GROUPS=120363AAA@g.us:Group Name 1,120363BBB@g.us:Group Name 2
# Single group (legacy format, still works):
#   WHATSAPP_GROUP_ID=120363AAA@g.us
#   WHATSAPP_GROUP_NAME=Group Name
#
# Run the bot without any group set first — it will print the ID of every
# group that sends a message. Copy the correct ID(s) and restart.
WHATSAPP_GROUPS=
WHATSAPP_GROUP_ID=

# Keywords filter — comma-separated words (Hebrew or any language).
# When set, the bot (live + scan) will ONLY save posts whose description
# contains at least one of these words. Leave empty to save everything.
# Example: SCAN_KEYWORDS=כיסא,ספה,מיטה,שולחן
SCAN_KEYWORDS=

# Auto-scan on startup — runs automatically after the bot connects and
# history sync finishes. No need to click "scan" in the web UI manually.
# AUTO_SCAN_DAYS: how many days back to scan (default: 30)
# AUTO_SCAN_MSGS_PER_DAY: max messages per day per group (default: 500)
AUTO_SCAN_DAYS=30
AUTO_SCAN_MSGS_PER_DAY=500

# Port for the website (default: 3000)
PORT=3000

# Admin PIN — protects destructive operations (delete items, scan, group management).
# Leave blank (or remove) to keep the existing open-access behaviour (backwards-compatible).
# Example: ADMIN_PIN=1234
ADMIN_PIN=
