# Copy this file to .env and fill in your values
# (The .env file is private — never share it or commit it to git)

# The EXACT name of your WhatsApp group (copy-paste from WhatsApp)
WHATSAPP_GROUP_NAME=שוק מתנות

# Your group's WhatsApp ID (e.g. 120363XXXXXXXXXX@g.us)
# Run the bot WITHOUT this set first — it will print the ID when any group
# message arrives. Copy the correct ID here and restart the bot.
# Once this is set, the bot starts instantly with no browser lookup needed.
WHATSAPP_GROUP_ID=

# Port for the website (default: 3000)
PORT=3000
